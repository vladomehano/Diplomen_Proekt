@page
@model EmailModel
@{
    ViewData["Title"] = "Имейл";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row g-4">
    <div class="col-12 col-lg-4">
        <partial name="_ManageNav" />
    </div>
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h4 class="h5 mb-3">Имейл настройки</h4>
        <form id="email-form" method="post">
             <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
            @if (Model.IsEmailConfirmed)
            {
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Текущ имейл</label>
                    <div class="input-group">
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" disabled />
                        <span class="input-group-text text-success">Потвърден</span>
                    </div>
                </div>
            }
            else
            {
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Текущ имейл</label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" disabled />
                            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link px-0">Изпрати имейл за потвърждение</button>
                        </div>
                    }
                    <div class="mb-4">
                        <label asp-for="Input.NewEmail" class="form-label">Нов имейл</label>
                        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="new@example.com" />
                        <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
                    </div>
                    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary px-4">Промени имейл</button>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

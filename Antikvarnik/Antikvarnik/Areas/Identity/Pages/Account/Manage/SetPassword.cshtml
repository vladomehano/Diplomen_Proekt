@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Парола";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3>Смяна на парола</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row g-4">
    <div class="col-12 col-lg-4">
        <partial name="_ManageNav" />
    </div>
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <p class="text-body-secondary">
                    Ако нямаш локална парола за този сайт, можеш да зададеш такава и да влизаш директно с имейл и парола.
                </p>
                <form id="set-password-form" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Input.NewPassword" class="form-label">Нова парола</label>
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Потвърди новата парола</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary px-4">Запази парола</button>
        </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model IndexModel
@{
    ViewData["Title"] = "Профил";   
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row g-4">
    <div class="col-12 col-lg-4">
        <partial name="_ManageNav" />
    </div>
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h4 class="h5 mb-3">Основна информация</h4>
        <form id="profile-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Потребителско име</label>
                        <input asp-for="Username" class="form-control" placeholder="Потребителско име" disabled />
                    </div>
                    <div class="mb-4">
                        <label asp-for="Input.PhoneNumber" class="form-label">Телефон</label>
                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+359..." />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                    </div>
                    <button id="update-profile-button" type="submit" class="btn btn-primary px-4">Запази промените</button>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

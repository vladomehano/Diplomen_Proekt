@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<ul class="navbar-nav align-items-lg-center gap-lg-1">
    @if (SignInManager.IsSignedIn(User))
    {
         <li class="nav-item">
             <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Профил">Здравей, @User.Identity?.Name!</a>
    </li>
    <li class="nav-item">
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-secondary btn-sm ms-lg-2">Изход</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
    </li>
    <li class="nav-item">
            <a class="btn btn-primary btn-sm ms-lg-2" asp-area="Identity" asp-page="/Account/Login">Вход</a>
        </li>
    }
</ul>
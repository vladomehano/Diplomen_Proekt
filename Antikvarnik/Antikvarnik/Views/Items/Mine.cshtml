@model Item[]

@{
    ViewData["Title"] = "Моите артикули";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="mb-1">Моите артикули</h1>
        <p class="text-body-secondary mb-0">Управлявай всички активни и архивирани предложения от профила си.</p>
    </div>

<a asp-controller="Items" asp-action="Add" class="btn btn-primary">Добави нов артикул</a>
</div>

@if (Model.Length == 0)
{
    <div class="alert alert-info">
        Все още нямаш добавени артикули.
    </div>
}
else
{
   <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                <tr>
                    <th>Артикул</th>
                    <th>Категория</th>
                    <th>Статус</th>
                    <th>Публикувано</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@item.MainPicUrl" alt="@item.Name" style="width:52px;height:52px;object-fit:cover;border-radius:8px;" />
                                <div>
                                    <div class="fw-semibold">@item.Name</div>
                                    <div class="text-muted small">@item.Price.ToString("F2") лв.</div>
                                </div>
                            </div>
                        </td>
                        <td>@(item.Category?.Name ?? "—")</td>
                        <td>
                                    <span class="badge text-bg-secondary">@item.Status</span>
                        </td>
                        <td>@item.CreatedOn.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-end">
                            <a asp-controller="Items" asp-action="Details" asp-route-itemId="@item.Id" class="btn btn-sm btn-outline-primary">
                                Детайли и комуникация
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
                </table>
            </div>
        </div>
    </div>
}
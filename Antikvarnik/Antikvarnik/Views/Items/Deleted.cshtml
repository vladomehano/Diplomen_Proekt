@model Item[]

@{
    ViewData["Title"] = "Скрити артикули";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="mb-1 text-danger">Скрити артикули</h1>
        <p class="text-body-secondary mb-0">Артикули, които са временно скрити и могат да бъдат възстановени в каталога.</p>
    </div>
    <a asp-controller="Items" asp-action="Index" class="btn btn-outline-dark">Към каталога</a>
</div>


@if (Model.Length == 0)
{
    
    <div class="alert alert-info">Няма скрити артикули.</div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <article class="card h-100 border-0 shadow-sm">
                    <img src="@item.MainPicUrl" class="card-img-top" alt="@item.Name" style="height: 240px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h2 class="h5 mb-0">@item.Name</h2>
                            <span class="badge text-bg-danger">Скрит</span>
                        </div>
                        <p class="text-muted small mb-1">Категория: @(item.Category?.Name ?? "Без категория")</p>
                        <p class="text-muted small mb-2">Статус: @item.Status</p>
                        <p class="card-text text-muted flex-grow-1">@item.Description</p>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            
                 
                            <form asp-controller="Items" asp-action="Restore" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="itemId" value="@item.Id" />
                                <button type="submit" class="btn btn-success">Възстанови в каталога</button>
                            </form>
                        </div>
                    </div>
                </article>
            </div>
        }

    </div>
}